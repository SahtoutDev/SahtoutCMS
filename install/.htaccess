Options -Indexes

<FilesMatch "\.inc\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Enable URL rewriting
RewriteEngine On

# Only rewrite if the requested file or folder doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite URLs to add .php automatically
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L]
